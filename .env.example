# New bot from @BotFather, and the chat id alerts go to (only this chat can use /add etc.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solana: Helius key (websocket + enhanced transaction parsing)
HELIUS_API_KEY=
# Ignore incoming-only SOL dust below this (address-poisoning spam)
SOL_MIN_INCOMING=0.001

# EVM chains to watch, from chains.js: ethereum,base,bsc,arbitrum,monad
EVM_CHAINS=ethereum,base,bsc,arbitrum,monad
EVM_POLL_SECONDS=60
# Optional Alchemy key: used only as a backup when the public RPCs fail or rate-limit
ALCHEMY_API_KEY=
# Optional own RPC per chain (comma separated, tried first):
# RPC_BASE=https://...

